<section class="se-painel log-painel log-vitrine"><header class="log-heading"><div><span class="log-kicker">Operações da equipe</span><h3>Expedições e Recursos</h3><p>Planeje a saída. Registre a jornada. Organize o retorno.</p></div>{{#if gm}}<button class="log-primary" type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="expedicao"><i class="fas fa-plus" aria-hidden="true"></i> Criar expedição</button>{{/if}}</header><div class="log-overview"><div><strong>{{totalExpedicoes}}</strong><span>Expedições registradas</span></div><div><strong>{{totalAtivas}}</strong><span>Em andamento</span></div><div class="log-overview-action">{{#if gm}}<button type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="relogio"><i class="fas fa-clock" aria-hidden="true"></i> Avançar relógio da equipe</button>{{else}}<span>Tempo compartilhado<br>controlado pelo Mestre</span>{{/if}}</div></div>
{{#each expedicoes}}<article class="log-card log-operation"><header class="log-base-header"><span class="log-emblem" aria-hidden="true"><i class="fas fa-route"></i></span><div class="log-title"><span class="log-kicker">Expedição</span><h3>{{nome}}</h3><span class="log-location"><i class="fas fa-campground" aria-hidden="true"></i> {{origemNome}}</span></div><span class="log-status log-status-{{estado}}">{{estadoNome}}</span></header><p class="log-texto log-description">{{objetivo}}</p><div class="log-operation-stats"><div><span class="log-kicker">Equipe</span><strong>{{totalParticipantes}} participantes</strong><small>{{#if participantesNomes}}{{participantesNomes}}{{else}}Nenhum participante selecionado{{/if}}</small></div><div><span class="log-kicker">Planejamento</span><strong>{{planejado}} min</strong><small>Duração estimada</small></div><div><span class="log-kicker">Tempo registrado</span><strong>{{minutos}} min</strong><small>Não avança o relógio</small></div></div>
{{#if retorno}}<aside class="log-return"><i class="fas fa-flag" aria-hidden="true"></i><div><span class="log-kicker">Condições de retorno</span><p class="log-texto">{{retorno}}</p></div></aside>{{/if}}
<div class="log-toolbar">{{#if @root.gm}}<button type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="expedicao" data-id="{{id}}">Configurar expedição</button><button type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="esforco" data-id="{{id}}">Resolver esforço de viagem</button><button type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="conferirEsforco">Conferir esforço interrompido</button><button class="log-danger" type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="excluir" data-tipo="expedicao" data-id="{{id}}" ><i class="fas fa-trash-alt" aria-hidden="true"></i> Excluir</button><button type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="estado" data-expedicao="{{id}}">Alterar estado</button>{{/if}}<button type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="resumo" data-expedicao="{{id}}"><i class="fas fa-file-alt" aria-hidden="true"></i> Resumo da jornada</button></div>
<div class="log-section-title"><h4><i class="fas fa-route" aria-hidden="true"></i> Rota da expedição</h4><span>{{concluidos}} / {{totalTrechos}} trechos</span></div><progress class="log-progress" value="{{progresso}}" max="100" aria-label="Progresso da rota de {{nome}}">{{progresso}}%</progress>
{{#if podeEditar}}<div class="log-toolbar"><button type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="trecho" data-expedicao="{{id}}">+ Adicionar trecho</button></div>{{/if}}<div class="log-route">{{#each trechos}}<details class="log-route-step {{#if concluido}}log-completed{{/if}}"><summary><span class="log-step-number">{{#if concluido}}✓{{else}}{{numero}}{{/if}}</span><span><strong>{{nome}}</strong><small>{{estimativa}} min de base · {{ritmo}} · {{classe}} · {{#if concluido}}Concluído{{else}}Pendente{{/if}}</small></span><i class="fas fa-chevron-down" aria-hidden="true"></i></summary><div class="log-step-body"><div class="log-info-grid"><div><span class="log-kicker">Atmosfera</span><p>{{#if atmosfera}}{{atmosfera}}{{else}}Não informada{{/if}}</p></div><div><span class="log-kicker">Gravidade / terreno</span><p>{{#if gravidade}}{{gravidade}}{{else}}Não informado{{/if}}</p></div></div>{{#if perigos}}<span class="log-kicker">Perigos conhecidos</span><p class="log-texto">{{perigos}}</p>{{/if}}{{#if condicoes}}<p class="log-texto">{{condicoes}}</p>{{/if}}{{#if concluido}}<p class="log-muted">Duração efetiva: {{real}} segundos.</p>{{else}}<div class="log-toolbar">{{#if ../podeEditar}}<button type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="trecho" data-expedicao="{{../id}}" data-id="{{id}}">Editar trecho</button>{{/if}}{{#if @root.gm}}<button class="log-primary" type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="concluir" data-expedicao="{{../id}}" data-id="{{id}}">Concluir e registrar tempo</button>{{/if}}</div>{{/if}}{{#if ../podeEditar}}<button class="log-danger" type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="excluir" data-tipo="trecho" data-id="{{id}}" data-expedicao="{{../id}}"><i class="fas fa-trash-alt" aria-hidden="true"></i> Excluir</button>{{/if}}</div></details>{{else}}<div class="log-empty"><i class="fas fa-route" aria-hidden="true"></i><p>Trace o caminho da próxima saída.</p><small>Adicione destinos, perigos e duração estimada de cada trecho.</small></div>{{/each}}</div>
<div class="log-section-title"><h4><i class="fas fa-clipboard-check" aria-hidden="true"></i> Preparação de recursos</h4><span>{{recursosProntos}} / {{totalRecursos}} preparados</span></div>{{#if podeEditar}}<div class="log-toolbar"><button type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="checklist" data-expedicao="{{id}}">+ Recurso necessário</button></div>{{/if}}<div class="log-checklist">{{#each checklist}}<div class="log-check {{#if pronto}}log-check-ready{{/if}}"><span class="log-check-symbol" aria-hidden="true">{{#if pronto}}✓{{else}}○{{/if}}</span><span>{{nome}}</span>{{#if ../podeEditar}}<button type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="checklist" data-expedicao="{{../id}}" data-id="{{id}}">{{#if pronto}}Desmarcar{{else}}Preparado{{/if}}</button><button class="log-danger" type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="excluir" data-tipo="checklist" data-id="{{id}}" data-expedicao="{{../id}}"><i class="fas fa-trash-alt" aria-hidden="true"></i> Remover</button>{{/if}}</div>{{else}}<p class="log-muted">Nenhum recurso listado. O checklist não reserva nem duplica itens.</p>{{/each}}</div>
<div class="log-section-title"><h4><i class="fas fa-book-open" aria-hidden="true"></i> Diário de campo</h4>{{#if podeAnotar}}<button type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="nota" data-expedicao="{{id}}">+ Registrar descoberta</button>{{/if}}</div>{{#each notas}}<div class="log-nota"><header><span><i class="fas fa-pen" aria-hidden="true"></i> <strong>{{usuario}}</strong><small>Tempo do mundo: {{tempo}} s</small></span>{{#if podeEditar}}<button type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="nota" data-expedicao="{{../id}}" data-id="{{id}}">Editar anotação</button><button class="log-danger" type="button" data-action="extensao" data-ext="log-expedicoes" data-acao="excluir" data-tipo="nota" data-id="{{id}}" data-expedicao="{{../id}}"><i class="fas fa-trash-alt" aria-hidden="true"></i> Excluir</button>{{/if}}</header><p class="log-texto">{{texto}}</p></div>{{else}}<div class="log-empty"><i class="fas fa-book-open" aria-hidden="true"></i><p>A jornada ainda não tem registros.</p><small>Descobertas, ameaças e recursos deixados ficam reunidos aqui.</small></div>{{/each}}</article>{{else}}<div class="log-empty log-onboarding"><i class="fas fa-compass" aria-hidden="true"></i><h4>A próxima saída começa aqui</h4><p>Crie uma expedição e reúna objetivo, rota, equipe e condições de retorno.</p></div>{{/each}}</section>
