<div class="log-central-frame"><header class="log-central-top"><div><span class="log-kicker">Sangue Escuro · Central de operações</span><h2>Expedições e Abrigos</h2></div><label>Personagem de referência<select data-log-personagem><option value="" disabled>Selecione um personagem</option>{{#each personagens}}<option value="{{id}}" {{#if selecionado}}selected{{/if}}>{{nome}}</option>{{/each}}</select></label></header><nav class="log-central-nav" aria-label="Áreas da central">{{#each abas}}<button type="button" data-action="mudarAba" data-aba="{{id}}" class="{{#if ativa}}ativo{{/if}}" aria-pressed="{{ativa}}"><i class="fas {{icone}}" aria-hidden="true"></i> {{nome}}</button>{{/each}}</nav><div class="log-central-body">{{{conteudo}}}</div></div>
