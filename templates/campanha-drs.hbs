<section class="log-panel"><div class="log-hero"><div><span class="log-kicker">DRS consolidado · 13/11/2026</span><h2>Campanha e infraestrutura</h2><p>Planejamento, recursos e trabalho compartilhado. O Mestre confirma condições e custos; o relógio não avança sozinho.</p></div></div>
<div class="log-section-title"><h3>Setores da Zona Segura</h3>{{#if gm}}<button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="setor" >+ Registrar setor</button>{{/if}}</div>{{#each setores}}<article class="log-card"><h3>{{nome}}</h3><p>{{abrigoNome}} · {{estado}}</p><p>{{beneficio}}</p><p>Construção: {{horas}} h · CD {{cd}} · {{materiais}}</p><p class="log-texto">{{nota}}</p><div class="log-toolbar">{{#if equipado}}<button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="testeSetor" data-id="{{id}}">Teste no setor</button>{{/if}}{{#if @root.gm}}<button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="setor" data-id="{{id}}">Editar</button><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="construir" data-id="{{id}}">Construir</button><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="excluir" data-tipo="setores" data-id="{{id}}">Excluir</button>{{/if}}</div></article>{{else}}<div class="log-empty">Registre setores em um abrigo existente.</div>{{/each}}
<div class="log-section-title"><h3>Procedimentos e projetos</h3>{{#if gm}}<div class="log-toolbar"><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="procedimento" >+ Procedimento</button><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="projeto" >+ Projeto conhecido</button></div>{{/if}}</div><p class="log-muted">Materiais efetivamente usados são contabilizados pelo Mestre conforme cada regra. Concluir um projeto básico cria somente um exemplar no inventário do responsável. Sem duplicar tempo no relógio.</p>{{#each procedimentos}}<article class="log-card"><h3>{{nome}}{{#if concluido}} · Concluído{{/if}}</h3><p class="log-texto">{{nota}}</p>{{#if @root.gm}}<div class="log-toolbar"><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="procedimento" data-id="{{id}}">Editar procedimento</button><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="excluir" data-tipo="procedimentos" data-id="{{id}}">Excluir procedimento</button></div>{{/if}}{{#each etapas}}<div class="log-nota"><h4>{{numero}} · {{nome}} · {{estado}}</h4><p>{{responsavelNome}} · {{minutos}} min · {{pericia}} CD {{cd}}</p><p class="log-texto">{{requisitos}}</p>{{#if @root.gm}}<div class="log-toolbar"><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="etapa" data-id="{{../id}}" data-etapa="{{id}}">Editar etapa</button><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="excluirEtapa" data-id="{{../id}}" data-etapa="{{id}}">Excluir etapa</button><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="operarEtapa" data-id="{{../id}}" data-etapa="{{id}}" data-operacao="iniciar">Iniciar</button><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="operarEtapa" data-id="{{../id}}" data-etapa="{{id}}" data-operacao="resolver">Resolver</button><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="operarEtapa" data-id="{{../id}}" data-etapa="{{id}}" data-operacao="interromper">Interromper</button><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="operarEtapa" data-id="{{../id}}" data-etapa="{{id}}" data-operacao="reabrir">Reabrir</button></div>{{/if}}</div>{{/each}}</article>{{else}}<div class="log-empty">Crie um procedimento com duas a quatro etapas ou use um dos três projetos do catálogo básico.</div>{{/each}}
<div class="log-section-title"><h3>Relógios de ameaça</h3>{{#if gm}}<button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="relogio" >+ Registrar</button>{{/if}}</div>{{#each relogios}}<article class="log-card"><h3>{{nome}}</h3><p>{{progresso}} / {{max}} segmentos{{#if encerrado}} · Encerrado{{/if}}</p><p class="log-texto">{{gatilhos}}</p><p class="log-texto">{{nota}}</p>{{#if @root.gm}}<div class="log-toolbar"><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="relogio" data-id="{{id}}">Editar</button><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="avancarRelogio" data-id="{{id}}">Avaliar / intervir</button><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="excluir" data-id="{{id}}" data-tipo="relogios">Excluir</button></div>{{/if}}</article>{{else}}<div class="log-empty">Nenhum registro.</div>{{/each}}
<div class="log-section-title"><h3>Acordos e dívidas</h3>{{#if gm}}<button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="acordo" >+ Registrar</button>{{/if}}</div>{{#each acordos}}<article class="log-card"><h3>{{nome}}</h3><p>{{estado}}</p><p class="log-texto">{{nota}}</p>{{#if @root.gm}}<div class="log-toolbar"><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="acordo" data-id="{{id}}">Editar</button><button type="button" data-action="extensao" data-ext="log-campanha-drs" data-acao="excluir" data-id="{{id}}" data-tipo="acordos">Excluir</button></div>{{/if}}</article>{{else}}<div class="log-empty">Nenhum registro.</div>{{/each}}
</section>