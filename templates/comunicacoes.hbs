<section class="se-painel log-painel log-vitrine"><header class="log-heading"><div><span class="log-kicker">Rede de comunicações</span><h3>Comunicações e Terminais</h3><p>Mensagens, registros e gravações liberados para a equipe.</p></div>{{#if radio}}<button type="button" class="log-primary" data-action="extensao" data-ext="log-comunicacoes" data-acao="radio"><i class="fas fa-broadcast-tower" aria-hidden="true"></i> Transmitir pelo rádio</button>{{/if}}</header>{{#if gm}}<div class="log-toolbar"><button type="button" data-action="extensao" data-ext="log-comunicacoes" data-acao="terminal">+ Terminal</button><button type="button" data-action="extensao" data-ext="log-comunicacoes" data-acao="arquivo">+ Arquivo / gravação</button></div>{{/if}}
{{#each terminais}}<article class="log-card"><header class="log-base-header"><span class="log-emblem" aria-hidden="true"><i class="fas fa-desktop"></i></span><div class="log-title"><span class="log-kicker">Terminal</span><h3>{{nome}}</h3><span class="log-location">{{local}}</span></div><span class="log-status">{{#if liberado}}Liberado{{else}}Restrito{{/if}}</span></header>{{#if @root.gm}}<div class="log-toolbar"><button type="button" data-action="extensao" data-ext="log-comunicacoes" data-acao="terminal" data-id="{{id}}">Configurar acesso</button><button class="log-danger" type="button" data-action="extensao" data-ext="log-comunicacoes" data-acao="excluir" data-tipo="terminal" data-id="{{id}}" ><i class="fas fa-trash-alt" aria-hidden="true"></i> Excluir</button><button type="button" data-action="extensao" data-ext="log-comunicacoes" data-acao="arquivo" data-terminal="{{id}}">+ Arquivo</button></div>{{/if}}{{#each arquivos}}<div class="log-nota"><header><span><strong>{{nome}}</strong><small>{{#if audio}}Gravação{{else}}Registro textual{{/if}} · {{#if publicado}}Liberado{{else}}Rascunho{{/if}}</small></span><button type="button" data-action="extensao" data-ext="log-comunicacoes" data-acao="ler" data-id="{{id}}">Abrir</button></header><p>{{resumo}}</p>{{#if @root.gm}}<button type="button" data-action="extensao" data-ext="log-comunicacoes" data-acao="arquivo" data-id="{{id}}">Editar / liberar</button><button class="log-danger" type="button" data-action="extensao" data-ext="log-comunicacoes" data-acao="excluir" data-tipo="arquivo" data-id="{{id}}" ><i class="fas fa-trash-alt" aria-hidden="true"></i> Excluir</button>{{/if}}</div>{{else}}<p class="log-muted">Nenhum arquivo disponível para este usuário.</p>{{/each}}</article>{{else}}<div class="log-empty"><i class="fas fa-desktop" aria-hidden="true"></i><p>Nenhum terminal disponível.</p><small>O Mestre libera o acesso e os arquivos para os usuários escolhidos.</small></div>{{/each}}
{{#if avulsos}}<div class="log-section-title"><h4>Mensagens e arquivos recebidos</h4></div>{{/if}}{{#each avulsos}}<article class="log-card"><header class="log-heading"><h3>{{nome}}</h3><button type="button" data-action="extensao" data-ext="log-comunicacoes" data-acao="ler" data-id="{{id}}">Abrir</button></header><p>{{resumo}}</p><small>{{#if publicado}}Liberado{{else}}Rascunho do Mestre{{/if}}</small>{{#if @root.gm}}<button type="button" data-action="extensao" data-ext="log-comunicacoes" data-acao="arquivo" data-id="{{id}}">Editar / liberar</button><button class="log-danger" type="button" data-action="extensao" data-ext="log-comunicacoes" data-acao="excluir" data-tipo="arquivo" data-id="{{id}}" ><i class="fas fa-trash-alt" aria-hidden="true"></i> Excluir</button>{{/if}}</article>{{/each}}</section>
