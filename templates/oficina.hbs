<section class="se-painel log-painel log-vitrine"><header class="log-heading"><div><span class="log-kicker">Manutenção de equipamentos</span><h3>Oficina</h3><p>Ordens de serviço, materiais e recuperação de durabilidade.</p></div><button type="button" class="log-primary" data-action="extensao" data-ext="log-oficina" data-acao="criar">+ Nova ordem</button></header><p class="log-muted">Personagem selecionado: {{personagem}}. O Mestre confirma ferramentas, materiais e o início de cada serviço. O relógio não é avançado automaticamente.</p>{{#if gm}}<button type="button" data-action="extensao" data-ext="log-oficina" data-acao="descanso">Registrar novo descanso seguro do responsável selecionado</button>{{/if}}
{{#each ordens}}<article class="log-card"><header class="log-base-header"><span class="log-emblem" aria-hidden="true"><i class="fas fa-tools"></i></span><div class="log-title"><span class="log-kicker">{{procedimento}}</span><h3>{{nome}}</h3><span class="log-location">{{responsavelNome}} · {{abrigoNome}}</span></div><span class="log-status">{{estadoNome}}</span></header><div class="log-base-numbers"><span>Mecânica CD <strong>{{cd}}</strong></span><span><strong>{{minutos}}</strong> minutos de serviço</span>{{#if emServico}}<span><strong>{{restante}}</strong> minutos restantes</span>{{/if}}</div><span class="log-kicker">Materiais e ferramentas</span><p class="log-texto">{{materiais}}</p>{{#if nota}}<p class="log-texto">{{nota}}</p>{{/if}}{{#if @root.gm}}<div class="log-toolbar">{{#if podeExcluir}}<button class="log-danger" type="button" data-action="extensao" data-ext="log-oficina" data-acao="excluir" data-tipo="oficina" data-id="{{id}}" ><i class="fas fa-trash-alt" aria-hidden="true"></i> Excluir</button>{{/if}}{{#if pendente}}<button type="button" class="log-primary" data-action="extensao" data-ext="log-oficina" data-acao="conferir" data-id="{{id}}">Conferir reparo interrompido</button>{{else}}{{#if aguardando}}<button type="button" data-action="extensao" data-ext="log-oficina" data-acao="iniciar" data-id="{{id}}">Iniciar serviço</button>{{/if}}{{#if emServico}}<button type="button" class="log-primary" data-action="extensao" data-ext="log-oficina" data-acao="concluir" data-id="{{id}}">Resolver teste e reparo</button>{{/if}}{{#if aguardando}}<button type="button" data-action="extensao" data-ext="log-oficina" data-acao="cancelar" data-id="{{id}}">Cancelar</button>{{/if}}{{#if emServico}}<button type="button" data-action="extensao" data-ext="log-oficina" data-acao="cancelar" data-id="{{id}}">Cancelar</button>{{/if}}{{/if}}</div>{{/if}}{{#each historico}}<p class="log-muted">{{resultado}} · Teste {{teste}} · PD {{pdAntes}} → {{pdDepois}} · {{tempo}} s</p>{{/each}}</article>{{else}}<div class="log-empty"><i class="fas fa-tools" aria-hidden="true"></i><h4>Nenhum serviço na fila</h4><p>Selecione um personagem e abra uma ordem para uma arma com durabilidade.</p></div>{{/each}}</section>
