<section class="se-painel log-painel log-vitrine">
<header class="log-heading"><div><span class="log-kicker">Logística do grupo</span><h3>Abrigos e Armazenamento</h3><p>Bases, instalações e suprimentos da equipe.</p></div>{{#if gm}}<button class="log-primary" type="button" data-action="extensao" data-ext="log-abrigos" data-acao="abrigo"><i class="fas fa-plus" aria-hidden="true"></i> Criar abrigo</button>{{/if}}</header>
<div class="log-overview"><div><strong>{{totalAbrigos}}</strong><span>Abrigos disponíveis</span></div><div><strong>{{totalInstalacoes}}</strong><span>Instalações registradas</span></div><div><strong>{{totalDepositos}}</strong><span>Depósitos</span></div></div>
{{#each pendentes}}<aside class="log-alerta"><strong>Movimentação aguardando conferência</strong><p>{{direcao}} · {{quantidade}} × {{nome}}</p><button type="button" data-action="extensao" data-ext="log-abrigos" data-acao="conferir" data-id="{{id}}">Conferir transferência</button></aside>{{/each}}
{{#each abrigos}}<article class="log-card log-base"><header class="log-base-header">{{#if imagem}}<img class="log-base-image" src="{{imagem}}" alt="{{nome}}">{{else}}<span class="log-emblem" aria-hidden="true"><i class="fas fa-shield-alt"></i></span>{{/if}}<div class="log-title"><span class="log-kicker">Abrigo da equipe</span><h3>{{nome}}</h3><span class="log-location"><i class="fas fa-map-marker-alt" aria-hidden="true"></i> {{#if local}}{{local}}{{else}}Localização não informada{{/if}}</span></div><span class="log-status log-status-{{estado}}">{{estadoNome}}</span></header>
{{#if descricao}}<p class="log-texto log-description">{{descricao}}</p>{{/if}}
<div class="log-base-numbers"><span><strong>{{totalInstalacoes}}</strong> instalações</span><span><strong>{{totalDepositos}}</strong> depósitos</span><span><strong>{{totalItens}}</strong> unidades em estoque</span></div>
<details class="log-disclosure"><summary><i class="fas fa-door-open" aria-hidden="true"></i> Acessos e vulnerabilidades</summary><div class="log-info-grid"><div><span class="log-kicker">Acessos</span><p class="log-texto">{{#if acessos}}{{acessos}}{{else}}Nenhum acesso descrito.{{/if}}</p></div><div><span class="log-kicker">Vulnerabilidades</span><p class="log-texto">{{#if vulnerabilidades}}{{vulnerabilidades}}{{else}}Nenhuma vulnerabilidade registrada.{{/if}}</p></div></div></details>
{{#if @root.gm}}<div class="log-toolbar"><button type="button" data-action="extensao" data-ext="log-abrigos" data-acao="abrigo" data-id="{{id}}"><i class="fas fa-cog" aria-hidden="true"></i> Configurar abrigo</button><button class="log-danger" type="button" data-action="extensao" data-ext="log-abrigos" data-acao="excluir" data-tipo="abrigo" data-id="{{id}}" ><i class="fas fa-trash-alt" aria-hidden="true"></i> Excluir</button><button type="button" data-action="extensao" data-ext="log-abrigos" data-acao="deposito" data-abrigo="{{id}}">+ Depósito</button><button type="button" data-action="extensao" data-ext="log-abrigos" data-acao="instalacao" data-abrigo="{{id}}">+ Instalação</button></div>{{/if}}
<div class="log-section-title"><h4><i class="fas fa-tools" aria-hidden="true"></i> Instalações</h4><span>{{totalInstalacoes}} registradas</span></div><div class="log-facilities">{{#each instalacoes}}<details class="log-facility"><summary><i class="fas fa-tools" aria-hidden="true"></i><span>{{nome}}<small>{{estadoNome}}</small></span><i class="fas fa-chevron-down" aria-hidden="true"></i></summary><div class="log-facility-body"><span class="log-kicker">Requisitos</span><p class="log-texto">{{#if requisitos}}{{requisitos}}{{else}}Nenhum requisito descrito.{{/if}}</p><span class="log-kicker">Efeitos</span><p class="log-texto">{{#if efeitos}}{{efeitos}}{{else}}Nenhum efeito descrito.{{/if}}</p>{{#if @root.gm}}<button type="button" data-action="extensao" data-ext="log-abrigos" data-acao="instalacao" data-abrigo="{{../id}}" data-id="{{id}}">Editar instalação</button><button class="log-danger" type="button" data-action="extensao" data-ext="log-abrigos" data-acao="excluir" data-tipo="instalacao" data-id="{{id}}" data-abrigo="{{../id}}"><i class="fas fa-trash-alt" aria-hidden="true"></i> Excluir</button>{{/if}}</div></details>{{else}}<div class="log-empty"><i class="fas fa-tools" aria-hidden="true"></i><p>Nenhuma instalação cadastrada.</p><small>Oficinas, enfermarias e outros serviços ficam reunidos aqui.</small></div>{{/each}}</div>
<div class="log-section-title"><h4><i class="fas fa-boxes" aria-hidden="true"></i> Armazenamento</h4><span>{{totalDepositos}} depósitos</span></div>
{{#each depositos}}<section class="log-deposito {{#if excesso}}log-excesso{{/if}}" data-log-deposito="{{id}}" data-abrigo="{{../id}}"><header class="log-depot-heading"><div><span class="log-kicker">Depósito</span><h4>{{nome}}</h4></div><span class="log-capacity"><strong>{{ocupado}}</strong> / {{capacidade}}<small>capacidade utilizada</small></span>{{#if @root.gm}}<button type="button" title="Editar depósito" aria-label="Editar depósito {{nome}}" data-action="extensao" data-ext="log-abrigos" data-acao="deposito" data-abrigo="{{../id}}" data-id="{{id}}"><i class="fas fa-cog" aria-hidden="true"></i></button><button class="log-danger" type="button" data-action="extensao" data-ext="log-abrigos" data-acao="excluir" data-tipo="deposito" data-id="{{id}}" data-abrigo="{{../id}}"><i class="fas fa-trash-alt" aria-hidden="true"></i> Excluir</button>{{/if}}</header><progress class="log-progress" value="{{percentual}}" max="100" aria-label="Ocupação do depósito {{nome}}">{{percentual}}%</progress><div class="log-meter-label"><span>{{totalItens}} unidade(s) armazenadas</span><span>{{#if excesso}}Capacidade excedida{{else}}{{livre}} de espaço livre{{/if}}</span></div>
{{#if ../podeOperar}}<div class="log-toolbar"><button class="log-primary" type="button" data-action="extensao" data-ext="log-abrigos" data-acao="depositar" data-abrigo="{{../id}}" data-deposito="{{id}}"><i class="fas fa-box-open" aria-hidden="true"></i> Depositar da ficha</button><span class="log-muted">Ou arraste um item do inventário para este depósito.</span></div>{{/if}}
{{#each itens}}<div class="log-item" draggable="{{podeOperar}}" data-log-item="{{id}}" data-abrigo="{{../../id}}" data-deposito="{{../id}}">{{#if imagem}}<img class="log-item-image" src="{{imagem}}" alt="" loading="lazy">{{else}}<span class="log-item-symbol" aria-hidden="true"><i class="fas fa-box"></i></span>{{/if}}<span class="log-item-name"><strong>{{nome}}</strong><small>{{tipo}} · {{espacoNome}} espaço/un.{{#if pd}} · PD {{pd}}{{/if}}</small></span><span class="log-quantity">×{{quantidade}}</span><div class="log-item-actions"><button type="button" data-action="extensao" data-ext="log-abrigos" data-acao="detalhes" data-item="{{id}}" data-abrigo="{{../../id}}" data-deposito="{{../id}}">Detalhes</button>{{#if podeOperar}}<button type="button" data-action="extensao" data-ext="log-abrigos" data-acao="retirar" data-item="{{id}}" data-abrigo="{{../../id}}" data-deposito="{{../id}}">Retirar</button>{{/if}}{{#if @root.gm}}<button class="log-danger" type="button" data-action="extensao" data-ext="log-abrigos" data-acao="excluir" data-tipo="estoque" data-id="{{id}}" data-abrigo="{{../../id}}" data-deposito="{{../id}}"><i class="fas fa-trash-alt" aria-hidden="true"></i> Descartar</button>{{/if}}</div></div>{{else}}<div class="log-empty log-drop-hint"><i class="fas fa-box-open" aria-hidden="true"></i><strong>Pronto para receber suprimentos</strong><p>Nenhum item armazenado neste depósito.</p></div>{{/each}}</section>{{else}}<div class="log-empty"><i class="fas fa-boxes" aria-hidden="true"></i><p>O abrigo ainda não possui depósitos.</p></div>{{/each}}</article>{{else}}<div class="log-empty log-onboarding"><i class="fas fa-campground" aria-hidden="true"></i><h4>Um ponto de retorno para a equipe</h4><p>Cadastre um abrigo para organizar instalações e suprimentos.</p></div>{{/each}}
{{#if historicoPermitido}}<details class="log-disclosure log-history"><summary><i class="fas fa-history" aria-hidden="true"></i> {{#if gm}}Histórico do Mestre{{else}}Minhas movimentações{{/if}} · {{historicoDisponiveis}} registros</summary><div class="log-toolbar"><button type="button" data-action="extensao" data-ext="log-abrigos" data-acao="historicoFiltros">Filtrar histórico</button><button type="button" data-action="extensao" data-ext="log-abrigos" data-acao="historicoReset">Limpar filtros</button>{{#if gm}}<button type="button" data-action="extensao" data-ext="log-abrigos" data-acao="historicoExportar">Exportar resultados (JSON)</button><button class="log-danger" type="button" data-action="extensao" data-ext="log-abrigos" data-acao="historicoLimpar">Limpar histórico</button>{{/if}}</div>{{#if historicoFiltros}}<p class="log-muted">{{historicoFiltros}}</p>{{/if}}<p class="log-muted">{{historicoTotal}} registros encontrados · Página {{historicoPagina}} de {{historicoPaginas}}</p>{{#each historico}}<div class="log-history-row"><span class="log-history-dot" aria-hidden="true"></span><div><strong>{{nome}}</strong><span class="log-muted"> · {{acao}}</span><p>{{detalhes}}</p><small>Tempo do mundo: {{tempo}} s{{#if registradoEmNome}} · Registro: {{registradoEmNome}}{{/if}}</small>{{#if abrigoNome}}<small> · Abrigo: {{abrigoNome}}</small>{{/if}}{{#if atorNome}}<small> · Personagem: {{atorNome}}</small>{{/if}}</div></div>{{else}}<p class="log-muted">Nenhum registro corresponde a estes filtros.</p>{{/each}}<div class="log-toolbar">{{#if historicoAnterior}}<button type="button" data-action="extensao" data-ext="log-abrigos" data-acao="historicoPagina" data-direcao="anterior">← Anterior</button>{{/if}}{{#if historicoProxima}}<button type="button" data-action="extensao" data-ext="log-abrigos" data-acao="historicoPagina" data-direcao="proxima">Próxima →</button>{{/if}}</div></details>{{/if}}</section>
